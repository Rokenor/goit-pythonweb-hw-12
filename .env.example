# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=contacts_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Рядок підключення, який використовують застосунок і Alembic
DB_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/contacts_app

# --- JWT --------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
PASSWORD_RESET_EXPIRATION_SECONDS=3600

# --- Redis (кеш поточного користувача) --------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLED=True
USER_CACHE_TTL=900

# --- SMTP (верифікація email, скидання пароля) ------------------------------
MAIL_USERNAME=example@meta.ua
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=example@meta.ua
MAIL_PORT=465
MAIL_SERVER=smtp.meta.ua
MAIL_FROM_NAME=Contacts API

# --- Cloudinary (аватари) ---------------------------------------------------
CLD_NAME=your_cloud_name
CLD_API_KEY=000000000000000
CLD_API_SECRET=your_api_secret

# --- API --------------------------------------------------------------------
API_PORT=8000
USER_ME_RATE_LIMIT=10/minute
